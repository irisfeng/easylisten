# Auth.js and one-time login codes
AUTH_SECRET=

# LightListen's dedicated Turso database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Transactional email
RESEND_API_KEY=
AUTH_EMAIL_FROM="轻听 <login@example.com>"

# Public base URL of the audio bucket, e.g. https://audio.example.com/audio.
# Leave empty only while full.mp3 files are still served from public/audio.
NEXT_PUBLIC_AUDIO_BASE_URL=
